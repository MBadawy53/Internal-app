# ------------------------------------------------------------------
# Contact Factoring — Digital Factoring Portal
# Copy to .env.local and fill in for your environment.
# ------------------------------------------------------------------

# Base URL of Contact's internal Factoring API gateway.
# Used by src/lib/api/http.ts once you switch off the mock data layer.
# Examples:
#   NEXT_PUBLIC_API_BASE_URL=https://api.internal.contact.eg/factoring/v1
#   NEXT_PUBLIC_API_BASE_URL=/api        # if you proxy through Next route handlers
NEXT_PUBLIC_API_BASE_URL=/api
