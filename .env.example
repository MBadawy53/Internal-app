# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://contact:contact@localhost:5432/contact_portal?schema=public
SHADOW_DATABASE_URL=postgresql://contact:contact@localhost:5432/contact_portal_shadow?schema=public
# DIRECT_URL is only required when DATABASE_URL is a pooled connection (e.g. Neon).
# For local Postgres you can leave this blank.
DIRECT_URL=

# ─── Auth.js ──────────────────────────────────────────────────────────────────
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_TRUST_HOST=true
SESSION_MAX_AGE_SECONDS=28800

# ─── Encryption (AES-256-GCM) ─────────────────────────────────────────────────
# 32 bytes hex (64 chars). Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# ─── i18n ─────────────────────────────────────────────────────────────────────
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar

# ─── Rate limiting / captcha (public page) ────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PUBLIC_FORM_RATE_LIMIT_PER_HOUR=5
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=stub                  # stub | resend | smtp
EMAIL_FROM="Contact Financial <noreply@contact.eg>"
RESEND_API_KEY=
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ─── SMS / WhatsApp (Twilio) ──────────────────────────────────────────────────
SMS_PROVIDER=stub                    # stub | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ─── Integrations (stubs by default) ──────────────────────────────────────────
CRM_PROVIDER=stub
CRM_BASE_URL=
CRM_API_KEY=

CORE_BANKING_PROVIDER=stub
CORE_BANKING_BASE_URL=
CORE_BANKING_API_KEY=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_PROVIDER=local
UPLOAD_LOCAL_DIR=./public/uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Seed defaults (dev only) ─────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@contact.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
